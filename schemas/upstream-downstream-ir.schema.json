{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MicroMilo/upstream-radar/blob/main/schemas/upstream-downstream-ir.schema.json",
  "title": "Upstream Radar upstream/downstream alignment IR",
  "description": "Evidence-only alignment between a source package and the published package/dependency graph consumed downstream.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "targetId", "ecosystem", "upstream", "downstream", "status", "checks"],
  "properties": {
    "schema": { "const": "upstream-radar.upstream-downstream-ir/v1alpha1" },
    "targetId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "ecosystem": { "enum": ["dsh", "codex", "pi"] },
    "upstream": {
      "$ref": "#/$defs/upstream"
    },
    "downstream": {
      "$ref": "#/$defs/downstream"
    },
    "status": { "$ref": "#/$defs/status" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/check" }
    }
  },
  "$defs": {
    "status": {
      "enum": ["aligned", "mismatch", "unknown"]
    },
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 512 },
        "version": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "packagePath", "coordinate"],
      "properties": {
        "repository": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "commit": { "type": "string", "minLength": 1, "maxLength": 256 },
        "packagePath": { "type": "string", "minLength": 1, "maxLength": 512 },
        "coordinate": { "$ref": "#/$defs/coordinate" }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "nodes", "edges", "unresolved"],
      "properties": {
        "status": { "enum": ["complete", "incomplete", "unavailable"] },
        "root": { "$ref": "#/$defs/coordinate" },
        "digest": { "type": "string", "minLength": 1, "maxLength": 512 },
        "nodes": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "edges": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "unresolved": { "type": "integer", "minimum": 0, "maximum": 1000000 }
      }
    },
    "downstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graph"],
      "properties": {
        "published": { "$ref": "#/$defs/coordinate" },
        "graph": { "$ref": "#/$defs/graph" }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "status", "summary"],
      "properties": {
        "code": { "enum": ["source-published-identity", "source-graph-root", "published-graph-root", "dependency-graph-coverage"] },
        "status": { "$ref": "#/$defs/status" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "upstream": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "downstream": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "remediation": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    }
  }
}
